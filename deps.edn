{:deps {com.monkeyci/script {:mvn/version "0.27.1-SNAPSHOT"}
        org.clojure/data.xml {:mvn/version "0.0.8"}}

 :paths ["src"]
 
 :aliases
 {:dev
  {:extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.5.34"}}}

  :test
  ;; clj -X:test
  {:extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.5.34"}
                com.monkeyprojects/build {:mvn/version "0.3.1"}}
   :extra-paths ["test" "dev-resources"]
   :exec-fn monkey.test/all}

  ;; clj -X:test:junit
  :junit
  {:exec-fn monkey.test/junit}

  ;; clj -X:test:watch
  :watch
  {:exec-fn monkey.test/watch}

  ;; clj -X:jar
  :jar
  {:extra-deps {com.monkeyprojects/build {:mvn/version "0.3.1"}}
   :exec-fn monkey.build/jar
   :exec-args {:jar "target/plugin-junit.jar"
               :version [[:env "LIB_VERSION"] "0.3.1-SNAPSHOT"]
               :lib com.monkeyci/plugin-junit
               :scm
               {:url "https://github.com/monkey-projects/plugin-junit"}
               :pom-data
               [[:licenses
                 [:license
                  [:name "MIT"]
                  [:url "https://mit-license.org/"]]]]}}

  :install
  ;; clj -T:jar:install
  {:exec-fn monkey.build/jar+install}
  
  ;; clj -T:jar:publish
  :publish
  {:exec-fn monkey.build/jar+deploy}}}
